  "item": [
    {
      "name": "准备数据-恢复成初始的 10 头牛（不算用例）",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8124/api/_reset",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "8124",
          "path": [
            "api",
            "_reset"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"数据已恢复成初始的 10 头牛\", function () {",
              "    pm.response.to.have.status(200);",
              "pm.expect(pm.response.json().data.count).to.eql(10);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "API-001 用户登录-正确密码",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"username\": \"admin\",\r\n  \"password\": \"123456\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://127.0.0.1:8124/api/login",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "8124",
          "path": [
            "api",
            "login"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 把登录拿到的 token 存进集合变量，后面用 {{token}} 引用",
              "var res = pm.response.json();",
              "console.log(\"取到的 token = \" + res.data.token);",
              "pm.collectionVariables.set(\"token\", res.data.token);",
              "",
              "pm.test(\"API-001 ① HTTP 状态码 = 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"API-001 ② code = 0\", function () {",
              "    pm.expect(pm.response.json().code).to.eql(0);",
              "});",
              "",
              "pm.test(\"API-001 ③ data 里有 token\", function () {",
              "    pm.expect(pm.response.json().data).to.have.property(\"token\");",
              "});",
              "",
              "pm.test(\"API-001 ④ data 里有 userId / username / role\", function () {",
              "    const d = pm.response.json().data;",
              "pm.expect(d).to.have.property(\"userId\");",
              "pm.expect(d).to.have.property(\"username\");",
              "pm.expect(d).to.have.property(\"role\");",
              "});",
              "",
              "pm.test(\"API-001 ⑤ data 里不含 password（安全要求）\", function () {",
              "    pm.expect(pm.response.json().data).to.not.have.property(\"password\");",
              "});"
            ]
          }
        }
      ]
    },
